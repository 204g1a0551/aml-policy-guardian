# ==============================================================================
# AML POLICY GUARDIAN — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and customize values for your deployment.
# NEVER commit sensitive API keys or production secrets to source control.
# ==============================================================================

# PostgreSQL & pgvector Database Configuration
POSTGRES_DB=aml_assistant
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST_PORT=5433

# Application Ports
BACKEND_PORT=8080
FRONTEND_PORT=4200

# Security & Authentication
# Generate a cryptographically secure 256-bit+ secret for production (e.g. openssl rand -hex 32)
JWT_SECRET=4c8b21e8e561a37c02b9e6584dc74c207b822d56a282f1b402179836371ad5f3e9c704a43b2f515e1bc09a656711c1e550b06b9b3e02

# AI LLM Provider Configuration
# For Google Gemini (OpenAI-compatible API endpoint):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=your-gemini-or-openai-api-key-here

# Embedding Model Configuration
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_API_KEY=your-embedding-api-key-here

# Spring Profile
SPRING_PROFILES_ACTIVE=docker
